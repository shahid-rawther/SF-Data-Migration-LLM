# Copy to .env and fill in. Note that python-dotenv reads plain KEY=value lines:
# a `set ` or `export ` prefix on the assignment makes the line unparseable and
# the variable is silently dropped.

# ── Agent transport ───────────────────────────────────────────────────────────
# boto3     — bedrock-runtime Converse API, credentials from the instance role.
# anthropic — Anthropic SDK against a Bedrock endpoint, credentials from the key
#             below. Left unset, the key's presence decides.
BEDROCK_PROVIDER=boto3

# Region for bedrock-runtime. AWS_REGION is used when this is unset.
BEDROCK_REGION=us-east-1

# Only for the anthropic transport.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── Models ────────────────────────────────────────────────────────────────────
# Defaults are the US geo inference profiles for the boto3 transport and the
# bare family names for the anthropic transport, so these are only needed to
# override. BEDROCK_MODEL_ID is a fallback for the relationship model.
BEDROCK_RELATIONSHIP_MODEL_ID=
BEDROCK_REPAIR_MODEL_ID=
BEDROCK_FIELD_MATCH_MODEL_ID=

# ── Autonomy and limits ───────────────────────────────────────────────────────
# preview — analyse and report only, never write a mapping config.
# apply   — write the resolution into the mapping configs (every change is
#           journalled in agent_changes and can be reverted individually).
AGENT_AUTONOMY=apply

AGENT_MAX_TOKENS_PER_CALL=8000
AGENT_MAX_TOKENS_PER_SESSION=200000
AGENT_MAX_TOOL_ITERATIONS=12
AGENT_TEMPERATURE=0.0

# Post-load repair: how many repair-and-retry rounds one object may consume.
AGENT_REPAIR_ENABLED=true
AGENT_REPAIR_MAX_ATTEMPTS=2

# Refuse to launch a migration whose lookup fields copy raw source ids, or whose
# required parents are missing from the selection.
AGENT_PREFLIGHT_ENFORCE=true

# Run the relationship agent when a migration starts, so anything still
# unresolved at launch is wired before extraction begins.
AGENT_AUTOWIRE=true

# Ask the model to review even when the deterministic checks found nothing they
# recognise. Those checks only cover the edge cases someone wrote a rule for, so
# without this an unanticipated one is never reported. Costs one model call per
# run; anything the review raises appears as a notice against the session.
AGENT_REVIEW_ALWAYS=true

# ── Model-assisted matching ───────────────────────────────────────────────────
# Gates both matching actions in the mapping step, which only ever propose:
# every pair is schema-checked and then accepted by a person.
#   "AI match remaining" pairs fields whose names differ but whose meaning
#   matches (u_caller_id -> ContactId).
#   "AI match values" pairs a source column's values with the ones a picklist
#   accepts (state "7" -> Closed), checked against the values the mapping's
#   record type offers and the controlling picklist where there is one.
AGENT_FIELD_MATCH=true
# Per-side cap on how many unmapped fields are shown to the model, so a wide
# table costs a predictable number of tokens. This is the only matching pass, so
# it sees whole tables rather than leftovers; the default clears a ServiceNow
# incident in one go. Beyond the cap the run is flagged as truncated and the
# remainder is picked up by running it again.
AGENT_FIELD_MATCH_MAX_FIELDS=250
# Field proposals under this confidence are discarded rather than offered, since
# an unmapped field costs one decision and a wrong one corrupts a column. Value
# proposals under it are applied and flagged for review instead: a value with no
# destination rejects the record on a restricted picklist, so withholding a loose
# pairing is not the safe option there.
AGENT_FIELD_MATCH_MIN_CONFIDENCE=0.5

# ── Resumable sessions (S3) ───────────────────────────────────────────────────
# Where a migration's progress is checkpointed, so a session interrupted part
# way through an object continues instead of restarting. What is stored is the
# record of what has already been written to the destination — the id map, the
# batch state, the resolved mapping configs and the progress counters — never
# credentials, and never the extracted source data, which stays on local disk.
MIGRATION_S3_BUCKET=
# Key prefix inside the bucket. One prefix can serve several environments.
MIGRATION_S3_PREFIX=itsm-migration
# Falls back to AWS_REGION, then BEDROCK_REGION, then us-east-1. Keep this in
# the same region as the instance: cross-region checkpoint writes add latency to
# every phase boundary and incur data-transfer charges.
MIGRATION_S3_REGION=us-east-1
# Leave empty to use the bucket's default encryption (SSE-S3). Set a KMS key id
# or ARN to encrypt with SSE-KMS instead.
MIGRATION_S3_KMS_KEY_ID=
# Set to false to run without checkpoints; sessions then restart from scratch.
MIGRATION_S3_ENABLED=true

# ── Mapping seeding ───────────────────────────────────────────────────────────
# The shipped JSON mappings are seeded into mapping_configs whenever the table
# is empty. Set to 0 to keep a deliberately cleared table empty; the files can
# still be loaded on demand via POST /api/mappings/import-from-json.
SEED_SYSTEM_MAPPINGS=1
