# Copy to .env and fill in. Note that python-dotenv reads plain KEY=value lines:
# a `set ` or `export ` prefix on the assignment makes the line unparseable and
# the variable is silently dropped.

# ── Agent transport ───────────────────────────────────────────────────────────
# boto3     — bedrock-runtime Converse API, credentials from the instance role.
# anthropic — Anthropic SDK against a Bedrock endpoint, credentials from the key
#             below. Left unset, the key's presence decides.
BEDROCK_PROVIDER=boto3

# Region for bedrock-runtime. AWS_REGION is used when this is unset.
BEDROCK_REGION=us-west-2

# Only for the anthropic transport.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── Models ────────────────────────────────────────────────────────────────────
# Defaults are the US geo inference profiles for the boto3 transport and the
# bare family names for the anthropic transport, so these are only needed to
# override. BEDROCK_MODEL_ID is a fallback for the relationship model.
BEDROCK_RELATIONSHIP_MODEL_ID=
BEDROCK_REPAIR_MODEL_ID=
BEDROCK_FIELD_MATCH_MODEL_ID=

# ── Autonomy and limits ───────────────────────────────────────────────────────
# preview — analyse and report only, never write a mapping config.
# apply   — write the resolution into the mapping configs (every change is
#           journalled in agent_changes and can be reverted individually).
AGENT_AUTONOMY=apply

AGENT_MAX_TOKENS_PER_CALL=8000
AGENT_MAX_TOKENS_PER_SESSION=200000
AGENT_MAX_TOOL_ITERATIONS=12
AGENT_TEMPERATURE=0.0

# Post-load repair: how many repair-and-retry rounds one object may consume.
AGENT_REPAIR_ENABLED=true
AGENT_REPAIR_MAX_ATTEMPTS=2

# Refuse to launch a migration whose lookup fields copy raw source ids, or whose
# required parents are missing from the selection.
AGENT_PREFLIGHT_ENFORCE=true

# Run the relationship agent when a migration starts, so anything still
# unresolved at launch is wired before extraction begins.
AGENT_AUTOWIRE=true

# ── Model-assisted field matching ─────────────────────────────────────────────
# The "AI match remaining" action in the mapping step, which pairs fields whose
# names differ but whose meaning matches (u_caller_id -> ContactId). It only
# proposes: every pair is schema-checked and then accepted by a person.
AGENT_FIELD_MATCH=true
# Per-side cap on how many unmapped fields are shown to the model, so a wide
# table costs a predictable number of tokens.
AGENT_FIELD_MATCH_MAX_FIELDS=150
# Proposals under this confidence are reported as discarded rather than offered.
AGENT_FIELD_MATCH_MIN_CONFIDENCE=0.5

# ── Mapping seeding ───────────────────────────────────────────────────────────
# The shipped JSON mappings are seeded into mapping_configs whenever the table
# is empty. Set to 0 to keep a deliberately cleared table empty; the files can
# still be loaded on demand via POST /api/mappings/import-from-json.
SEED_SYSTEM_MAPPINGS=1
