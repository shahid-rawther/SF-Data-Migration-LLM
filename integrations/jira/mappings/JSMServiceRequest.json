        },
        {
            "source_field": "jsm_service_requests.status",
            "transformation_function": "look_up_jsm_status",
            "destination_field": "Status"
        },
        {
            "source_field": "jsm_service_requests.priority",
            "transformation_function": "look_up_jsm_priority",
            "ignore_on_update": true,
            "destination_field": "Priority"
        },
        {
            "source_field": "jsm_service_requests.issuetype",
            "transformation_function": "look_up_jsm_category",
            "destination_field": "Category__c"
        },
        {
            "source_field": "jsm_service_requests.created",
