            "left_key": "sc_item_option",
            "right_table": "sc_item_option",
            "right_key": "sys_id",
            "type": "left"
        },
        {
            "left_table": "sc_item_option",
            "left_key": "item_option_new",
            "right_table": "item_option_new",
            "right_key": "sys_id",
            "type": "left"
        }
    ],
    "filters": [
        
    ],
    "operation": "insert",
    "salesforce_object": "SvcCatalogReqExtdAttrVal",
    "salesforce_objects": [
        {
            "object_name": "SvcCatalogReqExtdAttrVal",
            "fields": [
                "Id",
                "SvcCatalogRequestId",
                "TextValue",
                "SvcCatalogItemAttributeId"
            ]
        }
    ],
    "fields": [        
        {
            "source_field": "sc_item_option.sys_created_by",
            "transformation_function": "look_up_user_user_name",
            "destination_field": "CreatedById"
        },
        {
            "source_field": "sc_item_option.sys_created_on",
            "transformation_function": "convert_to_sf_time_format",
            "destination_field": "CreatedDate"
        },
        {
            "source_field": "sc_item_option.sys_updated_by",
            "transformation_function": "look_up_user_user_name",
            "destination_field": "LastModifiedById"
        },
        {
            "source_field": "sc_item_option.sys_updated_on",
            "transformation_function": "convert_to_sf_time_format",
            "destination_field": "LastModifiedDate"
        },
        {
            "source_field": "sc_item_option_mtom.request_item",
