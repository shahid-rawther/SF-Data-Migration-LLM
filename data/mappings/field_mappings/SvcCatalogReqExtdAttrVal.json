            "destination_field": "SvcCatalogRequestId"
        },
        {
            "destination_field": "TextValue",
            "source_field": "sc_item_option.value",
            "skip_if_not_found": true,
            "transformation_function": "empty_if_lengthy"          
        },
        {
            "destination_field": "SvcCatalogItemAttributeId",
            "transformation_function": "look_up_variable",
            "source_field": "sc_item_option.item_option_new"
        }
    ]
