{
    "priority": 2,
    "servicenow_tables": [
        "cmn_location"
    ],
    "joins": [],
    "filters": [],
    "operation": "insert",
    "salesforce_object": "Address",
    "fields": [
        {
            "source_field": "cmn_location.city",
            "destination_field": "City"
        },
        {
            "use_constant": "LOCATIONTYPE",
            "destination_field": "LocationType"
        },    
        {
            "source_field": "cmn_location.sys_id",
            "transformation_function": "look_up_sys_id",
            "destination_field": "ParentId"
        },
        {
            "source_field": "cmn_location.zip",
            "destination_field": "PostalCode"
        },
        {
            "source_field": "cmn_location.state",
            "destination_field": "State"
        },
        {
            "source_field": ["cmn_location.street", "cmn_location.u_street2"],
            "transformation_function": "join_fields",
            "destination_field": "Street"
        },
        {
            "use_constant": "TIMEZONE",
            "destination_field": "TimeZone"
        }        
    ]
}